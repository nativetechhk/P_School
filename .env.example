# === 必填 ===
# Gemini Developer API key（AI Studio 付費層）。留空時平台進入 MOCK 模式（產生測試用佔位圖，不呼叫任何 Google API）
GEMINI_API_KEY=
# Session 加密密鑰：openssl rand -hex 32
SESSION_SECRET=change-me-please-32-bytes-hex-change-me-please
DATABASE_URL=postgresql://user:password@localhost:5432/ai_class
REDIS_URL=redis://localhost:6379
# 作品／上載／匯出檔存放目錄
STORAGE_PATH=./data/uploads
APP_URL=http://localhost:3000

# === 選填 ===
# production 時設 true（需 https）
COOKIE_SECURE=false
# Cloud Vision / Speech 可共用 GEMINI_API_KEY；如需獨立 key 在此覆蓋
GOOGLE_API_KEY=
# 匯出 PDF 用的 Chrome/Chromium 路徑（Docker 內自動設定；Mac 預設找系統 Chrome）
CHROME_PATH=

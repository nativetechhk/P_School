{
  "_meta": {
    "version": 3,
    "description": "小小 AI 探索家 Prompt Engine 種子（v2.4）。masters 為導師指定的 10 位畫家（含代表作供 hover 參考）。變數：{A}{B}{C}{D}=選項 promptZh；{FREE}=自由字；{STYLE}=風格 promptZh；{STYLE_BOOST}=風格 boostEn；{PALETTE_ZH}/{PALETTE_HEX}=五色模式色票；{CHAR_NAME}=主角名。組裝順序：global.prefix → lesson.template → style.boostEn → global.suffix。",
    "assembly_order": ["global.prefix", "lesson.template", "style.boostEn", "global.suffix"]
  },

  "global": {
    "enabled": true,
    "prefix": "",
    "suffix": "children's picture book illustration, wholesome, bright and friendly, no humans, no people, no text, no letters, no watermark, no signature",
    "negativeTerms": "scary, horror, blood, weapon, violence, realistic human, photo of a person, nudity, logo, brand",
    "humanBlockTerms": ["男孩", "女孩", "小朋友", "小學生", "學生", "男人", "女人", "人", "老師", "同學", "自己", "我", "明星", "boy", "girl", "man", "woman", "kid", "child", "person", "people", "human"],
    "notes": "suffix 的 no humans 是最後防線；後台移除時彈出警告。"
  },

  "lessons": {
    "senior-l3-character": {
      "enabled": true, "name": "高年級第 3 節：主角設定卡", "kind": "generate", "aspect": "3:4",
      "slots": ["A", "B", "C", "D"],
      "slotLabels": {"A": "我的主角（動物／奇幻角色）", "B": "佢喺邊度", "C": "細節或光線", "D": "風格"},
      "template": "{A}，喺{B}，{C}。{FREE} 全身、置中、面向觀眾、簡單乾淨背景、角色設定圖。{D}。",
      "optionSets": {"A": "subjects_senior", "B": "environments", "C": "details_lighting", "D": "styles"},
      "defaultQuota": 10
    },
    "senior-l4-scene": {
      "enabled": true, "name": "高年級第 4 節：三幕場景", "kind": "generate", "aspect": "16:9",
      "slots": ["A", "C", "D"],
      "slotLabels": {"A": "場景主題", "C": "色調（三幕）", "D": "風格"},
      "template": "{A}的廣角全景，{C}。{FREE} 畫面中央留空位、沒有任何角色、沒有動物、沒有人物、遠景、細節豐富的背景。{D}。",
      "optionSets": {"A": "scene_themes", "C": "tones_three_acts", "D": "styles"},
      "actSlots": [
        {"id": "scene_1", "label": "第 1 幕：開始", "defaultC": "tone_warm_bright"},
        {"id": "scene_2", "label": "第 2 幕：危機", "defaultC": "tone_cold_dark"},
        {"id": "scene_3", "label": "第 3 幕：解決", "defaultC": "tone_golden"}
      ],
      "defaultQuota": 10,
      "notes": "D 格預設鎖定為第 3 節所選風格（可解鎖），令主角與場景風格一致。",
      "fiveColorMode": {"enabled": true, "paletteSet": "colors14", "maxColors": 5, "templateSuffix": " 整幅畫只能用以下 5 種顏色：{PALETTE_ZH}（{PALETTE_HEX}）。", "countColorsWithVision": true}
    },
    "senior-l5-style": {
      "enabled": true, "name": "高年級第 5 節：大師風格轉換（10 位畫家）", "kind": "edit", "aspect": "keep",
      "slots": ["STYLE"], "slotLabels": {"STYLE": "揀一位大師"},
      "template": "請以{STYLE}的風格重新繪畫這張圖。保留原本的構圖、主體和主要顏色分佈，不要加入新的物件、人物或文字。{STYLE_BOOST}",
      "optionSets": {"STYLE": "masters"}, "defaultQuota": 8,
      "notes": "輸入為第 3、4 節作品（最多 4 張），每張計 1 次配額；全班建議統一大師。"
    },
    "junior-l4-generate-style": {
      "enabled": true, "name": "低年級第 4 節：AI 畫畫＋名畫魔術師（兩步）", "kind": "two_step",
      "step1": {
        "kind": "generate", "aspect": "1:1", "slots": ["A", "B", "C"],
        "slotLabels": {"A": "咩寵物", "B": "咩顏色", "C": "喺邊度"},
        "template": "{A}，{B}，喺{C}。{FREE} 全身、置中、簡單背景、可愛兒童繪本風格。",
        "optionSets": {"A": "pets_junior", "B": "pet_colors_junior", "C": "environments"}
      },
      "step2": {
        "kind": "edit", "slots": ["STYLE"], "slotLabels": {"STYLE": "揀一位畫家"},
        "template": "請以{STYLE}的風格重新繪畫這張寵物圖。保留寵物的形狀、顏色和位置，不要加入文字或人物。{STYLE_BOOST}",
        "optionSets": {"STYLE": "masters"}
      },
      "allowUploadAsStep1": true, "defaultQuota": 6
    },
    "junior-l5-fivecolor": {
      "enabled": true, "name": "低年級第 5 節：五色魔法", "kind": "five_color",
      "edit": {
        "template": "請只用以下 5 種顏色重新繪畫這張圖：{PALETTE_ZH}（{PALETTE_HEX}）。保留原本的形狀和構圖，整幅畫只能出現這 5 種顏色及其深淺，不要加入其他顏色、文字或人物。",
        "boostEn": "limited palette of exactly 5 colors, flat color areas, no gradients outside the palette"
      },
      "generate": {
        "aspect": "1:1", "slots": ["A", "B", "C"],
        "slotLabels": {"A": "咩寵物", "B": "喺邊度", "C": "風格"},
        "template": "{A}，喺{B}，{C}。{FREE} 整幅畫只能用以下 5 種顏色：{PALETTE_ZH}（{PALETTE_HEX}）。",
        "optionSets": {"A": "pets_junior", "B": "environments", "C": "styles"}
      },
      "paletteSet": "colors14", "maxColors": 5, "countColorsWithVision": true, "defaultQuota": 6
    },
    "junior-l6-carousel": {
      "enabled": true, "name": "低年級第 6 節：作品輪播", "kind": "carousel",
      "minWorks": 3, "captionVoice": true, "defaultQuota": 0,
      "captionHint": "例如：呢個係我嘅火龍，我用咗梵谷風"
    },
    "senior-l6-carousel": {
      "enabled": true, "name": "高年級第 6 節：故事插圖輪播", "kind": "carousel",
      "minWorks": 4, "captionVoice": true, "defaultQuota": 0,
      "orderHint": ["character", "scene_1", "scene_2", "scene_3", "ai_reflection"],
      "textTasks": {
        "summarize_script": {
          "enabled": true, "model": "gemini-2.5-flash",
          "template": "你是小學課堂助手。以下是一位小五學生寫的三幕式劇本。請把它縮寫成 6 頁繪本旁白：第 1 頁封面只需書名；第 2 頁介紹主角；第 3–5 頁分別對應開始、危機、解決，每頁最多 2 句、每句不超過 20 個中文字；第 6 頁留空。用繁體中文，語氣活潑，不加入原文沒有的情節，不出現暴力或恐怖字眼。只輸出 JSON：{\"title\":\"\",\"pages\":[\"\",\"\",\"\",\"\",\"\"]}。\n\n劇本：\n{SCRIPT}"
        }
      }
    }
  },

